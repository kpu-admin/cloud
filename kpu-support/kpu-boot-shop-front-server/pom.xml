    <modelVersion>4.0.0</modelVersion>
    <artifactId>kpu-boot-shop-front-server-none</artifactId>
    <name>${project.artifactId}</name>
    <description>单体版-商城-启动模块</description>

    <dependencies>
        <!-- @kpu.generator auto insert server.pom.xml -->

